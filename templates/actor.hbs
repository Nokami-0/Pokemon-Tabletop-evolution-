{{#*inline "actorVitals"}}
      <label>Level <input name="system.level" type="number" min="1" {{#unless pokemon}}max="20"{{/unless}} value="{{system.level}}"></label>
      <label>HP (max {{system.health.max}}) <input name="system.health.value" type="number" min="0" max="{{system.health.max}}" value="{{system.health.value}}"></label>
      <label>Temp HP <input name="system.health.temp" type="number" min="0" value="{{system.health.temp}}"></label>
      <label>Spirit Points / 6 <input name="system.spirit" type="number" min="0" max="6" value="{{system.spirit}}"></label>
      <label>Movement (m) <input name="system.movement" type="number" min="0" value="{{system.movement}}"></label>
{{/inline}}
{{#*inline "itemGroups"}}
  {{#each this}}
  <section{{#if compact}} class="pte-compact-group"{{/if}}>
    <div class="pte-row"><h2>{{label}}</h2>{{#if @root.editable}}<button type="button" data-action="add" data-type="{{type}}" {{#if featureGroup}}data-feature-group="{{featureGroup}}"{{/if}} {{#if known}}data-known="true"{{/if}}>{{#if known}}Add Known Move{{else}}{{#if addLabel}}{{addLabel}}{{else}}Add {{type}}{{/if}}{{/if}}</button>{{/if}}</div>
    {{#if compact}}{{#if items}}<input type="search" data-item-query aria-label="Search {{label}}" placeholder="Search {{label}}">{{/if}}{{else}}<input type="search" data-item-query aria-label="Search {{label}}" placeholder="Search {{label}}">{{/if}}
    {{#each items}}
    <div class="pte-row pte-itemrow" data-item-search="{{name}} {{system.element}} {{system.category}}">
      <button type="button" data-action="open" data-id="{{id}}">{{name}}</button>
      {{#if system.spiritCost}}<small>{{system.spiritCost}} SP</small>{{/if}}
      {{#if move}}<span class="pte-type" data-element="{{system.element}}">{{system.element}}</span><small>{{system.category}} · {{system.frequency}} · {{system.range}}{{#if sceneUses}} · {{sceneUses}} used this scene{{/if}}</small>{{#if knownOnly}}<small>Known only</small>{{else}}<button type="button" data-action="move" data-id="{{id}}">Roll Only</button><button type="button" data-action="moveRange" data-id="{{id}}">Place Range</button>{{#if @root.editable}}<button type="button" data-action="trackedMove" data-id="{{id}}">Roll &amp; Track</button>{{/if}}{{/if}}{{#if @root.editable}}<button type="button" data-action="toggleBattleMove" data-id="{{id}}">{{#if knownOnly}}Move to Moves{{else}}Move to Known{{/if}}</button>{{/if}}{{/if}}
      {{#if gear}}<small>Qty {{system.quantity}}{{#if price}} · {{price}}{{/if}}</small>{{#if @root.editable}}{{#if usable}}<button type="button" data-action="useGear" data-id="{{id}}">Use</button>{{/if}}<button type="button" data-action="equip" data-id="{{id}}">{{#if system.equipped}}Unequip{{else}}Equip{{/if}}</button>{{/if}}{{/if}}
      {{#if @root.editable}}<button type="button" data-action="remove" data-id="{{id}}" aria-label="Remove {{name}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
    </div>
    {{/each}}
  </section>
  {{/each}}
{{/inline}}
<div class="pte-body">
  <nav class="pte-buttons" aria-label="Actor sheet sections">
    {{#each panels}}<button type="button" data-action="sheetPanel" data-panel="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}">{{label}}</button>{{/each}}
  </nav>
  <div class="pte-sheet-panel" data-sheet-panel="profile" {{#unless profileActive}}hidden{{/unless}}>
    {{#unless pokemon}}
    <div class="pte-card pte-trainer-card">
      <header class="pte-trainer-id">
        <div class="pte-trainer-id-title">
          <h2>TRAINER’S CARD</h2>
          <span class="pte-trainer-tier">Tier Level {{tier}} · Tier Value {{tierValue}}</span>
          <button type="button" data-action="books">Rule Library</button>
        </div>
        <div class="pte-trainer-id-content">
          <div class="pte-trainer-id-fields">
            <label class="pte-id-wide">Name <input name="name" value="{{actor.name}}" {{#unless editable}}readonly{{/unless}}></label>
            {{#each identityFields}}
              <label>{{label}} <input name="system.trainerIdentity.{{key}}" value="{{value}}" {{#unless @root.editable}}readonly{{/unless}}></label>
            {{/each}}
            <label>Size <select name="system.trainerIdentity.size" {{#unless editable}}disabled{{/unless}}>
              <option value="" disabled {{#unless trainerSizeSelected}}selected{{/unless}}>Choose size</option>
              {{#each trainerSizeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}
            </select></label>
          </div>
          <div class="pte-trainer-id-portrait">
            <img src="{{actor.img}}" alt="Trainer portrait">
            {{#if editable}}<div class="pte-buttons pte-trainer-art-actions">
              <button type="button" data-action="trainerArtwork" data-art="portrait">Edit Portrait</button>
              <button type="button" data-action="trainerArtwork" data-art="token">Edit Token</button>
            </div>{{/if}}
          </div>
        </div>
        <fieldset class="pte-grid pte-trainer-vitals" {{#unless editable}}disabled{{/unless}}>
          {{> actorVitals}}
        </fieldset>
      </header>
      <div class="pte-trainer-card-details">
        <section class="pte-compact-group">
          <div class="pte-row">
            <h2>Wallet · {{walletBalance}}</h2>
            {{#if editable}}<div class="pte-buttons">
              <button type="button" data-action="wallet" data-mode="credit">Add Money</button>
              <button type="button" data-action="wallet" data-mode="debit">Spend Money</button>
            </div>{{/if}}
          </div>
          {{#if walletHistory}}<details><summary>Recent transactions</summary>
            <ul>{{#each walletHistory}}<li>{{this}}</li>{{/each}}</ul>
          </details>{{/if}}
        </section>
        {{> itemGroups trainerCardGroups}}
      </div>
    </div>
    {{/unless}}
    {{#if pokemon}}
    <div class="pte-card pte-pokemon-card" role="region" aria-label="Pokémon Profile">
      <header class="pte-trainer-id">
        <div class="pte-trainer-id-title">
          <h2>POKÉMON PROFILE</h2>
          <span class="pte-trainer-tier">Tier Level {{tier}} · Tier Value {{tierValue}}</span>
          <div class="pte-buttons">
            <button type="button" data-action="books">Rule Library</button>
            <button type="button" data-action="dex" class="pte-dex-button">Pokédex</button>
            {{#if system.dexPage}}<button type="button" data-action="profile">Species Details</button>{{/if}}
          </div>
        </div>
        <div class="pte-trainer-id-content">
          <fieldset class="pte-trainer-id-fields" {{#unless editable}}disabled{{/unless}}>
            <label class="pte-id-wide">Name <input name="name" value="{{actor.name}}"></label>
            <label>Species <input name="system.species" value="{{system.species}}"></label>
            <label>Role <input name="system.role" value="{{system.role}}"></label>
            <label>Primary Type <select name="system.type1" data-element="{{system.type1}}">{{#each type1}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
            <label>Secondary Type <select name="system.type2" data-element="{{system.type2}}">{{#each type2}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
            {{#if system.xp}}<label>Legacy XP <input name="system.xp" type="number" min="0" value="{{system.xp}}"></label>{{/if}}
          </fieldset>
          <div class="pte-trainer-id-portrait">
            <img src="{{actor.img}}" alt="Pokémon portrait" {{#if editable}}data-action="editImage" data-edit="img"{{/if}}>
          </div>
        </div>
        <fieldset class="pte-grid pte-trainer-vitals" {{#unless editable}}disabled{{/unless}}>
          {{> actorVitals}}
        </fieldset>
      </header>
      <div class="pte-trainer-card-details">
      <section class="pte-compact-group">
    <div class="pte-row"><h2>Pokémon Roles</h2>{{#if editable}}<button type="button" data-action="add" data-type="feature" data-roles="true">Add Role</button>{{/if}}</div>
    <p>Rank 1 effect {{#if rankOneUnlocked}}unlocked{{else}}unlocks at level 10{{/if}} · Second role option at level 30</p>
    <input type="search" data-item-query aria-label="Search roles" placeholder="Search roles">
    {{#each roles}}<div class="pte-row pte-itemrow" data-item-search="{{name}}">
      <button type="button" data-action="open" data-id="{{id}}">{{name}}</button>
      <small>Primary role stat options · {{startingStats}}</small>
      {{#if description}}<details style="flex-basis:100%"><summary>Role effect</summary>
        <p class="pte-rule-text">{{description}}</p>
      </details>{{/if}}
      {{#if ../editable}}<button type="button" data-action="remove" data-id="{{id}}" aria-label="Remove {{name}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
    </div>{{/each}}
  </section>
      <section class="pte-compact-group">
        <div class="pte-row"><h2>Ability List</h2>{{#if editable}}{{#if speciesAbilities}}<button type="button" data-action="chooseAbility">Choose Ability</button>{{/if}}{{/if}}</div>
        {{#if speciesAbilities}}<ul><li>{{speciesAbilities}}</li></ul>{{else}}<p>Select a species from the Pokédex to see its available abilities.</p>{{/if}}
        {{#if ownedAbilities}}<h3>Selected Abilities</h3>
          {{#each ownedAbilities}}<div class="pte-row pte-itemrow">
            <button type="button" data-action="open" data-id="{{id}}">{{name}}</button>
            {{#if spiritCost}}<small>{{spiritCost}} SP</small>{{/if}}
            {{#if ../editable}}<button type="button" data-action="remove" data-id="{{id}}" aria-label="Remove {{name}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
          </div>{{/each}}
        {{/if}}
      </section>
      </div>
    </div>
    {{else}}
    {{> itemGroups profileGroups}}
    {{#if system.trainerClass}}
      <label>Class notes <input name="system.trainerClass" value="{{system.trainerClass}}" {{#unless editable}}readonly{{/unless}}></label>
    {{/if}}
    {{/if}}
  {{#if editable}}<div class="pte-buttons" aria-label="Spirit Point controls">
    <button type="button" data-action="spirit" data-mode="spend">Spend SP</button>
    <button type="button" data-action="spirit" data-mode="gain">Gain SP</button>
    <button type="button" data-action="spirit" data-mode="session" title="Apply once at session start for this Trainer or a selected team Pokémon">Session SP (+{{tier}})</button>
  </div>{{/if}}
  {{#if trainerProgression}}
  <section>
    <h2>Trainer Progression</h2>
    <p>Level {{system.level}} of 20 · Pokémon level cap {{trainerProgression.cap}} · {{system.levelPoints}} unspent stat points</p>
    <fieldset {{#unless editable}}disabled{{/unless}} class="pte-grid">
      <label>Merits (goal {{trainerProgression.meritGoal}}) <input type="number" name="system.merits" min="0" value="{{system.merits}}"></label>
      <label>Custom Merit goal (0 uses the rulebook) <input type="number" name="system.meritGoal" min="0" value="{{system.meritGoal}}"></label>
    </fieldset>
    {{#if editable}}<div class="pte-buttons">
      {{#if trainerProgression.canStart}}<button type="button" data-action="startTrainerProgression">Level 1 Setup</button>{{/if}}
      {{#if trainerProgression.canLevel}}<button type="button" data-action="advanceTrainer">Level Up</button>{{/if}}
      {{#if system.levelPoints}}<button type="button" data-action="allocateStatPoints">Allocate Points</button>{{/if}}
    </div>{{/if}}
    {{#if trainerProgression.virtuoso}}<p>Virtuoso · {{trainerProgression.virtuoso}}</p>{{/if}}
    <details><summary>Advancement rules</summary>
      <p>At Level 1, choose four Features and two Talents. Each later level grants one Class or General Feature, plus a Talent or skill rank. Add chosen Features and Talents from the Trainer Card.</p>
      <p>At Levels 5, 10, and 15, choose Skill Specialty or raise two qualifying skills. Levels 5 and 15 also grant ten extra stat points. Apply up to five levels to each eligible Pokémon using its own progression controls.</p>
      <small>PTE Rule Book, p. 25</small>
    </details>
    {{#if trainerProgression.history}}<details><summary>Advancement history</summary>
      <ul>{{#each trainerProgression.history}}<li>{{this}}</li>{{/each}}</ul>
    </details>{{/if}}
  </section>
  {{/if}}
  <section>
    <h2>Battle Stats</h2>
    {{#if defensiveMatchups}}<details>
      <summary>Incoming attack type matchups</summary>
      <ul>{{#each defensiveMatchups}}<li><span class="pte-type" data-element="{{type}}">{{type}}</span> · {{label}}</li>{{/each}}</ul>
    </details>{{/if}}
    <fieldset class="pte-grid" {{#unless editable}}disabled{{/unless}}>
      {{#each stats}}<label>{{label}} <input name="system.stats.{{key}}" type="number" min="0" value="{{value}}"></label>{{/each}}
      <label>Accuracy Mod <input name="system.accuracy" type="number" value="{{system.accuracy}}"></label>
      <label>Evasion Mod <input name="system.evasion" type="number" value="{{system.evasion}}"></label>
      <label>Damage Reduction <input name="system.reduction" type="number" min="0" value="{{system.reduction}}"></label>
    </fieldset>
    <p>Physical / Special / Speed Evasion · {{evasion}}</p>
    <div class="pte-buttons">
      {{#if editable}}
        <button type="button" data-action="initiative">Roll Initiative</button>
        <button type="button" data-action="initiative" data-party="true">Roll Party Initiative</button>
      {{/if}}
      <button type="button" data-action="luck">Luck Check</button>
      <button type="button" data-action="save">Affliction Save</button>
      {{#if editable}}<button type="button" data-action="damage">Apply Damage</button><button type="button" data-action="rest">Rest &amp; Recovery</button>{{/if}}
    </div>
  </section>
  <section>
    <h2>Combat Stages</h2>
    <p>Effective movement · {{effectiveMovement}} m</p>
    <fieldset class="pte-grid" {{#unless editable}}disabled{{/unless}}>
      {{#each stages}}<div>
        <strong>{{label}} · {{effective}}</strong>
        <label>Current stage <input name="system.stages.{{key}}" type="number" min="-6" max="6" value="{{current}}"></label>
        <label>Scene default <input name="system.defaultStages.{{key}}" type="number" min="-6" max="6" value="{{defaultStage}}"></label>
      </div>{{/each}}
    </fieldset>
    {{#if editable}}<button type="button" data-action="resetStages">Reset to Scene Defaults</button>{{/if}}
  </section>
  {{#if pokemon}}<section>
    <h2>Pokémon Progression</h2>
    {{#if editable}}{{#if system.dexPage}}<div class="pte-buttons">
      <button type="button" data-action="speciesArtwork">Apply Species Artwork</button>
      <button type="button" data-action="speciesTokenSize">Apply Species Token Size</button>
      <button type="button" data-action="learnSpeciesMove">Learn Species Move</button>
      <button type="button" data-action="evolvePokemon">Evolve Pokémon</button>
    </div>{{/if}}{{/if}}
    <p>Battle attack slots · {{battleSlots}} / {{system.battleMoveLimit}}</p>
    <label>Battle attack limit <input type="number" min="0" name="system.battleMoveLimit" value="{{system.battleMoveLimit}}" {{#unless editable}}disabled{{/unless}}></label>
    <p>{{#if trainerCap}}Trainer level cap · {{trainerCap}} · {{/if}}Unspent level-up stat points · {{system.levelPoints}}</p>
    {{#if editable}}<div class="pte-buttons">{{#if trainerCap}}<button type="button" data-action="levelPokemon">Apply Level Gain</button>{{/if}}
      {{#if system.levelPoints}}<button type="button" data-action="allocateStatPoints">Allocate Points</button>{{/if}}</div>{{/if}}
    {{#if pokemonProgression.trained}}<p>Trained skills (+2d6 per training) · {{#each pokemonProgression.trained}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>{{/if}}
    <details><summary>Progression rewards</summary>
      <p>At level 1, select a Pokédex species, choose an Ability and a Primary Role, and learn its starting attacks. At level 10, your Primary Role’s Rank 1 effect unlocks. At level 30, choose a second Role or Ability from the Profile.</p>
      <p>Review the Species Profile for evolution requirements. At levels 25, 50, 75, and 100, ask the GM about an optional custom upgrade.</p>
      {{#if editable}}<div class="pte-buttons">
        {{#each pokemonProgression.rewards}}<button type="button" data-action="pokemonReward" data-reward="{{key}}">Lv {{level}} · {{label}}</button>{{/each}}
      </div>{{/if}}
      <small>PTE Rule Book, pp. 189–191</small>
    </details>
    {{#if pokemonProgression.history}}<details><summary>Advancement history</summary>
      <ul>{{#each pokemonProgression.history}}<li>{{this}}</li>{{/each}}</ul>
    </details>{{/if}}
  </section>{{/if}}
  {{#if pokemon}}<section>
    <h2>Species Profile</h2>
    {{#if speciesProfile}}
      {{#if speciesProfile.profile}}<p>{{speciesProfile.profile}}</p>{{/if}}
      {{#if speciesProfile.evolution}}<p class="pte-evolution"><strong>Evolution</strong><br>{{speciesProfile.evolution}}</p>{{/if}}
      {{#if speciesProfile.starting}}<details><summary>Starting attacks</summary>
        <ul>{{#each speciesProfile.starting}}<li>{{this}}</li>{{/each}}</ul>
      </details>{{/if}}
      {{#if speciesProfile.levelUp}}<details><summary>Level-up attacks</summary>
        <ul>{{#each speciesProfile.levelUp}}<li>{{this}}</li>{{/each}}</ul>
      </details>{{/if}}
      {{#if speciesProfile.tutor}}<details><summary>Tutor attacks</summary>
        <ul>{{#each speciesProfile.tutor}}<li>{{this}}</li>{{/each}}</ul>
      </details>{{/if}}
      <small>PTE Pokédex, p. {{speciesProfile.page}}</small>
    {{else}}
      <p>{{#if speciesProfileUnavailable}}Species details are unavailable for the current Pokédex selection.{{else}}Select a species from the Pokédex to show its profile.{{/if}}</p>
    {{/if}}
  </section>{{/if}}
  <section>
    <h2>Capabilities</h2>
    {{#each speciesCapabilities}}<p>{{this}}</p>{{/each}}
    {{#if classCapabilities}}<p>Granted by classes and features · {{#each classCapabilities}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}</p>{{/if}}
    <label>Gained or modified capabilities
      <textarea name="system.capabilityNotes" rows="2" {{#unless editable}}readonly{{/unless}}>{{system.capabilityNotes}}</textarea>
    </label>
    {{#if editable}}{{#if actorCapabilities}}
      <div class="pte-buttons" aria-label="Use capabilities">
        {{#each actorCapabilities}}<button type="button" data-action="capability" data-capability="{{name}}">{{name}}</button>{{/each}}
      </div>
    {{/if}}{{/if}}
    <details><summary>Capability rules</summary>
      {{#each capabilityGroups}}
        <h3>{{name}}</h3>
        <dl>{{#each entries}}
          <dt><strong>{{name}}</strong> {{#if @root.editable}}<button type="button" data-action="capability" data-capability="{{name}}">Use</button>{{/if}}</dt><dd>{{summary}} <small>PTE Rule Book, p. {{page}}</small></dd>
        {{/each}}</dl>
      {{/each}}
    </details>
  </section>
  {{#unless pokemon}}<section>
    <details><summary>Basic Orders</summary>
      <p>Each order uses your Reaction at the listed trigger. Your Pokémon must be able to hear you, usually within 10m. Orders do not stack on the same target at the same time, and repeated copies of an order do not stack.</p>
      <dl>
        <dt><strong>Defensive Order</strong></dt><dd>When your Pokémon is hit by a damaging attack, give it {{tierValue}} damage reduction against that attack.</dd>
        <dt><strong>Energetic Order</strong></dt><dd>When your Pokémon hits with a damaging attack, add {{tierValue}} to its damage roll.</dd>
        <dt><strong>Inspiring Order</strong></dt><dd>When your Pokémon would attack or make a save, give the triggering accuracy or save check +{{tier}}.</dd>
        <dt><strong>Reactive Order</strong></dt><dd>When your Pokémon is targeted by an attack or maneuver, give it +{{tier}} evasion against that action before its accuracy check.</dd>
        <dt><strong>Tactical Order</strong></dt><dd>When your Pokémon uses an attack, give its effect range or critical hit range a modifier of {{tier}}.</dd>
      </dl>
      <small>PTE Rule Book, p. 174</small>
    </details>
    <details><summary>Improvised Orders</summary>
      <p>Describe what you tell your Pokémon to do. The GM sets the effect, action cost, and skill check. The Trainer, recipient, or enemy may roll depending on the command. A trigger is optional. Use a Swift action as the baseline or a Standard action for a stronger effect. On a failed check the action is still spent, and the order has no effect.</p>
      <p>Example. Ask your Pokémon to pin an enemy with vines. The GM might call for the enemy to make an Acrobatics check or become Trapped.</p>
      <small>PTE Rule Book, p. 175</small>
    </details>
  </section>{{/unless}}
  {{#each pools}}
  <section>
    <h2>{{label}}</h2>
    <div class="pte-buttons">
      {{#each actions}}
      <button type="button" data-action="spendAction" data-pool="{{../key}}" data-key="{{key}}" aria-pressed="{{#if spent}}true{{else}}false{{/if}}" {{#unless ../editable}}disabled{{/unless}}>{{label}}{{#if spent}} · Spent{{/if}}</button>
      {{/each}}
      {{#if editable}}<button type="button" data-action="refreshActions" data-pool="{{key}}">Reset</button>{{/if}}
    </div>
  </section>
  {{/each}}

  <section>
    <details>
      <summary>Combat Maneuvers</summary>
      <p>Trainers and Pokémon can use these maneuvers unless a rule limits their access. Add the target’s Speed Evasion to the AC when applicable.</p>
      <p><strong>Resistant.</strong> After the maneuver hits, the target gains a Boon on related checks for the rest of the scene. If you fail its skill check, you also take a Bane when repeating it against a previously targeted enemy.</p>
      <h3>Bolster</h3>
      <dl>
        <dt><strong>Defend</strong> · Swift, Reaction, or Movement {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="defend">Use Defend</button>{{/if}}</dt>
        <dd>Choose an adjacent ally. Until your next turn starts, redirect single-target attacks from that ally to yourself while you remain adjacent. <small>PTE Rule Book, p. 170</small></dd>
        <dt><strong>Disengage</strong> · Movement {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="disengage">Use Disengage</button>{{/if}}</dt>
        <dd>Slide 1m. <small>PTE Rule Book, p. 170</small></dd>
        <dt><strong>Help</strong> · Swift {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="help">Use Help</button>{{/if}}</dt>
        <dd>An adjacent ally immediately makes an end-of-turn save against an affliction. You cannot use a damaging attack on the same turn as Help. <small>PTE Rule Book, p. 170</small></dd>
        <dt><strong>Hide</strong> · Movement {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="hide">Use Hide</button>{{/if}}</dt>
        <dd>Until your next turn starts, adjacent cover counts as blocking terrain and attackers suffer double penalties from rough terrain you occupy. <small>PTE Rule Book, p. 170</small></dd>
        <dt><strong>Intercept</strong> · Reaction {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="intercept">Use Intercept</button>{{/if}}</dt>
        <dd>When an ally within 3m would be hit by an enemy attack without Social or Sureshot, move to the ally or into the attack’s path and take the hit. Swap the ally to an adjacent space if you reach them. The hit is one damage step stronger (maximum ×1.5), or resisted if you would be immune. Spending a Standard action prevents the increase. An ally still inside an intercepted area attack gains one step of resistance. <small>PTE Rule Book, p. 170</small></dd>
        <dt><strong>Jump</strong> · Movement {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="jump">Use Jump</button>{{/if}}</dt>
        <dd>Move up to half your Movement in a straight line, including diagonally. Ignore ground terrain effects and hazards crossed, subject to GM rulings for hazards such as smoke. <small>PTE Rule Book, p. 170</small></dd>
        <dt><strong>Respite</strong> · Full {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="respite">Use Respite</button>{{/if}}</dt>
        <dd>Requires no enemies within 2m. Pick two benefits, with repeats allowed. Reset negative combat stages to default, cure an affliction, remove a condition independent of a current affliction, or remove a Coat or Mark. Then reset all positive combat stages to default. <small>PTE Rule Book, p. 171</small></dd>
        <dt><strong>Sprint</strong> · Standard or Swift {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="sprint">Use Sprint</button>{{/if}}</dt>
        <dd>Double Movement this turn as a Standard action, or add 2 to Movement this turn as a Swift action. <small>PTE Rule Book, p. 171</small></dd>
        <dt><strong>Riposte</strong> · Standard + Reaction · AC 4 · Field {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="riposte">Roll Riposte</button>{{/if}}</dt>
        <dd>When you or an ally would take damage from a single-target, Line, or Blast attack without Sureshot, spend one use of a damaging attack and roll Riposte. On a hit, subtract your attack’s raw damage roll from the incoming raw roll. At zero or less the incoming attack misses every target and applies no effects. On a successful Riposte you cannot use it again that scene. See p. 171 for positioning, type requirements, and counter-damage. <small>PTE Rule Book, p. 171</small></dd>
      </dl>
      <h3>Manipulate</h3>
      <dl>
        <dt><strong>Analyze</strong> · Swift · No AC · 6m, one target {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="analyze">Use Analyze</button>{{/if}}</dt>
        <dd>Choose a combat-relevant detail about the target to investigate. The GM reveals what you can determine and may call for a skill check. Minor information may be a Free action. <small>PTE Rule Book, p. 172</small></dd>
        <dt><strong>Distract</strong> · Swift · AC 6 · 6m, one target {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="distract">Use Distract</button>{{/if}}</dt>
        <dd>Oppose Guile or Stealth with Focus or Perception. On a win, inflict Dazed or Provoke the target until the end of its next turn. Resistant. <small>PTE Rule Book, p. 172</small></dd>
        <dt><strong>Intrigue</strong> · Swift · AC 6 · 6m, one target {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="intrigue">Use Intrigue</button>{{/if}}</dt>
        <dd>Oppose Charm or Command with Focus or Intuition. On a win, inflict Entranced until the end of the target’s next turn. Resistant. <small>PTE Rule Book, p. 172</small></dd>
        <dt><strong>Provoke</strong> · Swift · AC 2 · 6m, one target {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="provoke">Use Provoke</button>{{/if}}</dt>
        <dd>The target makes a CR 3 Focus check, or CR 2 if you already failed this maneuver against it this scene. On failure it is Provoked by you until the end of its next turn. Resistant. <small>PTE Rule Book, p. 172</small></dd>
        <dt><strong>Terrorize</strong> · Swift · AC 6 · 6m, one target {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="terrorize">Use Terrorize</button>{{/if}}</dt>
        <dd>Oppose Command or Intimidate with Intimidate or Focus. On a win, inflict Suppressed until the end of the target’s next turn. Resistant. <small>PTE Rule Book, p. 172</small></dd>
      </dl>
      <h3>Tactic</h3>
      <dl>
        <dt><strong>Attack of Opportunity</strong> · Reaction {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="opportunity">Use Attack of Opportunity</button>{{/if}}</dt>
        <dd>When an adjacent enemy willingly moves to a nonadjacent space or makes a ranged attack against someone nonadjacent to it, you may make a Basic Attack against that enemy as a Free action. <small>PTE Rule Book, p. 173</small></dd>
        <dt><strong>Disarm</strong> · Swift · AC 4 · Melee, one target {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="disarm">Use Disarm</button>{{/if}}</dt>
        <dd>Both sides roll Combat or Stealth. On a win, drop an item from the target’s inventory slot or impair equipped gear until the end of its next turn. It can spend a Swift action to clear the impairment early. Resistant. <small>PTE Rule Book, p. 173</small></dd>
        <dt><strong>Grapple</strong> · Standard · No AC · Melee, one target · Sureshot {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="grapple">Use Grapple</button>{{/if}}</dt>
        <dd>Both sides roll Athletics or Combat. On a win, both become Grappled and you gain Dominance. Grappled combatants are Vulnerable, Provoke each other, and have restricted Movement actions. Teleporter Speed or Phasing prevents grappling. Resistant. See p. 173 for Drag, Strike, Secure, Cease, and contesting Dominance. <small>PTE Rule Book, p. 173</small></dd>
        <dt><strong>Hinder</strong> · Swift · AC 4 · Melee, one target {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="hinder">Use Hinder</button>{{/if}}</dt>
        <dd>Both sides roll Athletics or Combat. On a win, the target is Vulnerable against the next attack targeting it. Resistant. <small>PTE Rule Book, p. 173</small></dd>
        <dt><strong>Push</strong> · Swift or Movement · AC 2 · Melee, one target {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="push">Use Push</button>{{/if}}</dt>
        <dd>Both sides roll Athletics or Combat. On a win, slide the target away up to a number of meters equal to your higher Athletics or Combat rank minus its Weight Class. Resistant. <small>PTE Rule Book, p. 173</small></dd>
        <dt><strong>Throw</strong> · Standard · AC 4 {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="throw">Use Throw</button>{{/if}}</dt>
        <dd>Throw a Throwable item within 4m plus your Athletics rank. On a hit, apply the item’s effect. The maneuver gains Sureshot if the target is adjacent. <small>PTE Rule Book, p. 173</small></dd>
        <dt><strong>Trip</strong> · Standard · AC 4 · Melee, one target {{#if editable}}<button type="button" data-action="maneuver" data-maneuver="trip">Use Trip</button>{{/if}}</dt>
        <dd>Both sides roll Combat or Acrobatics. On a win, the target becomes Tripped. Resistant. <small>PTE Rule Book, p. 173</small></dd>
      </dl>
    </details>
  </section>
  {{#if editable}}<section>
    <h2>Attack Tracking · Turn {{system.attackTurn}}</h2>
    <div class="pte-buttons"><button type="button" data-action="basicAttack">Basic Attack</button><button type="button" data-action="advanceAttackTurn">Advance Attack Turn</button>
    <button type="button" data-action="resetAttackScene">Reset Attack Scene</button>
    <button type="button" data-action="manualRange">Place Manual Template</button>
    <button type="button" data-action="inspectRanges">Manage Map Templates</button>
    <button type="button" data-action="deleteRangeOnMap">Delete Template on Map</button>
    <button type="button" data-action="removeRange">Remove Last Template</button></div>
  </section>{{/if}}
  <section><h2>Notes</h2><textarea aria-label="Notes" name="system.biography" rows="4" {{#unless editable}}readonly{{/unless}}>{{system.biography}}</textarea></section>
  </div>
  <div class="pte-sheet-panel" data-sheet-panel="status" {{#unless statusActive}}hidden{{/unless}}>
  <section>
    <h2>Afflictions</h2>
    <div class="pte-buttons">
      {{#each afflictions}}<button type="button" data-action="toggleAffliction" data-key="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#unless ../editable}}disabled{{/unless}}>{{label}}</button>{{/each}}
    </div>
    {{#if potionEffects}}<p>Scene potion bonuses{{#each potionEffects}} · {{label}} +{{value}}{{/each}}</p>{{/if}}
    <label>Affliction details <textarea name="system.afflictionNotes" rows="2" {{#unless editable}}readonly{{/unless}}>{{system.afflictionNotes}}</textarea></label>
    {{#if editable}}<div class="pte-buttons"><button type="button" data-action="endTurnTicks">Apply End-Turn HP Loss</button>
    <button type="button" data-action="clearAfflictions">Clear Scene Afflictions and Potions</button></div>{{/if}}
  </section>
  <section>
    <h2>Conditions</h2>
    <div class="pte-buttons">
      {{#if fainted}}<strong>Fainted · 0 HP</strong>{{/if}}
      {{#each conditions}}<button type="button" data-action="toggleCondition" data-key="{{key}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" {{#if granted}}disabled title="Granted by another active effect"{{else}}{{#if ../fainted}}disabled{{else}}{{#unless ../editable}}disabled{{/unless}}{{/if}}{{/if}}>{{label}}{{#if granted}} (granted){{/if}}</button>{{/each}}
    </div>
    <label>Condition sources and durations <textarea name="system.conditionNotes" rows="2" {{#unless editable}}readonly{{/unless}}>{{system.conditionNotes}}</textarea></label>
    <small>PTE Rule Book, p. 183</small>
  </section>
  </div>
  <div class="pte-sheet-panel" data-sheet-panel="moves" {{#unless movesActive}}hidden{{/unless}}>
    {{#if pokemon}}<p>Battle move slots · {{battleSlots}} / {{system.battleMoveLimit}}</p>{{/if}}
    {{#if editable}}{{#if pokemon}}{{#if system.dexPage}}<div class="pte-buttons">
      <button type="button" data-action="learnSpeciesMove">Learn Species Move</button>
    </div>{{/if}}{{/if}}{{/if}}
    {{> itemGroups moveGroups}}
  </div>
  <div class="pte-sheet-panel" data-sheet-panel="known" {{#unless knownActive}}hidden{{/unless}}>
    {{#if editable}}{{#if pokemon}}{{#if system.dexPage}}<div class="pte-buttons">
      <button type="button" data-action="learnSpeciesMove" data-known="true">Learn Species Move</button>
    </div>{{/if}}{{/if}}{{/if}}
    {{> itemGroups knownGroups}}
  </div>
  <div class="pte-sheet-panel" data-sheet-panel="bag" {{#unless bagActive}}hidden{{/unless}}>
    {{#if editable}}<div class="pte-buttons"><button type="button" data-action="createWeapon">Create Weapon</button></div>{{/if}}
    {{> itemGroups bagGroups}}
  </div>
  <div class="pte-sheet-panel" data-sheet-panel="team" {{#unless teamActive}}hidden{{/unless}}>
    <section>
      <h2>Team</h2>
      {{#if pokemon}}
        <fieldset {{#unless editable}}disabled{{/unless}}>
          <label>Trainer <select name="system.trainerId"><option value="">Unassigned</option>{{#each trainers}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
        </fieldset>
      {{/if}}
      <div class="pte-buttons">
        {{#each partners}}<button type="button" data-action="openPartner" data-id="{{id}}">{{name}}</button>{{else}}
          <p>{{#if pokemon}}No other visible Pokémon share this Trainer.{{else}}Assign a Trainer on a Pokémon sheet to link it here.{{/if}}</p>
        {{/each}}
      </div>
    </section>
  </div>
  <div class="pte-sheet-panel" data-sheet-panel="skills" {{#unless skillsActive}}hidden{{/unless}}>
  <section>
    <h2>Skills</h2>
    {{#if speciesProfile.skillRanks}}
      <p><strong>Species skill ranks</strong> · {{speciesProfile.skillRanks}}</p>
      <details><summary>Pokémon skill dice by evolution stage</summary>
        <table>
          <thead><tr><th>Rank</th><th>First of three</th><th>Middle of three or first of two</th><th>Final or single stage</th></tr></thead>
          <tbody>
            <tr><th>Inept</th><td>1d6</td><td>1d6</td><td>2d6</td></tr>
            <tr><th>Untrained</th><td>2d6</td><td>2d6</td><td>3d6</td></tr>
            <tr><th>Proficient</th><td>3d6</td><td>4d6</td><td>5d6</td></tr>
            <tr><th>Mastered</th><td>4d6</td><td>5d6</td><td>6d6</td></tr>
          </tbody>
        </table>
        <p>Set the editable skill ranks below to the dice pools your Pokémon uses, including any training.</p>
      </details>
    {{/if}}
    {{#if editable}}<div class="pte-buttons"><button type="button" data-action="opposedSkill">Opposed Check</button>
      <button type="button" data-action="groupSkill">Group Check</button></div>{{/if}}
    <div class="pte-grid pte-skills">
      {{#each skills}}
      <label><button type="button" data-action="skill" data-index="{{index}}">{{label}}</button>
        <select name="system.skills.s{{index}}" aria-label="{{label}} rank" {{#unless ../editable}}disabled{{/unless}}>{{#each rank}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </label>
      {{/each}}
    </div>
  </section>
  </div>
</div>
