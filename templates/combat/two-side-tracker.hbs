<section class="pte-side-initiative">
  {{#if running}}
    <h3>{{#if partyMode}}Party / Group Initiative{{else}}Side Initiative{{/if}} · Round {{round}}</h3>
  {{else}}
    <details data-pte-initiative-setup>
      <summary>Group Initiative</summary>
      <label>Initiative mode
        <select name="pte-initiative-mode">
          <option value="sides">Two Sides</option>
          <option value="party">Party / Group</option>
        </select>
      </label>
      <div data-pte-side-setup>
      <p>Assign combatants to sides and enter a PTE initiative result for each side.</p>
      <div class="pte-side-scores">
        <label>Players <input type="number" name="pte-player-score" step="any"></label>
        <label>Opponents <input type="number" name="pte-opponent-score" step="any"></label>
        <label>On a tie
          <select name="pte-tie-winner">
            <option value="players">Players go first</option>
            <option value="opponents">Opponents go first</option>
          </select>
        </label>
      </div>
      {{#each sides}}
        <h4>{{label}}</h4>
        <ul>
          {{#each members}}
            <li>
              <span>{{name}}{{#if defeated}} (Defeated){{/if}}</span>
              <button type="button" data-side-action="move" data-member-id="{{id}}">Move to {{otherSide}}</button>
            </li>
          {{else}}
            <li>No combatants</li>
          {{/each}}
        </ul>
      {{/each}}
      {{#if canStart}}
        <button type="button" data-side-action="start">Start Side Initiative</button>
      {{else}}
        <p>Each side needs an undefeated combatant to start.</p>
      {{/if}}
      </div>
      <div data-pte-party-setup hidden>
        <p>Assign combatants to parties. Enter the total or highest skill successes from Roll Party Initiative, using the same method for all parties. On ties, parties go in the order listed here.</p>
        {{#each groupOptions}}
          <fieldset data-party-group="{{id}}" class="pte-side-scores">
            <label>Group name <input type="text" name="pte-party-name-{{id}}" data-party-label value="{{label}}"></label>
            <label>Initiative <input type="number" name="pte-party-score-{{id}}" step="any"></label>
          </fieldset>
        {{/each}}
        <button type="button" data-side-action="add-group">Add Group</button>
        <ul>
          {{#each partyMembers}}
            <li>
              <label>{{name}}{{#if hidden}} (Hidden){{/if}}
                <select name="pte-party-member-{{id}}">
                  {{#each groups}}
                    <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                  {{/each}}
                </select>
              </label>
            </li>
          {{/each}}
        </ul>
        <button type="button" data-side-action="start-party">Start Group Initiative</button>
      </div>
    </details>
  {{/if}}

  {{#if running}}
    {{#if partyMode}}<p>Choose up to two combatants to act this initiative, then advance.</p>{{/if}}
    {{#each sides}}
      <div class="pte-side{{#if active}} pte-side-active{{/if}}">
        <h4>{{label}} · {{score}}{{#if active}} · Acting now{{/if}}</h4>
        <ul>
          {{#each members}}
            <li>
              <span>{{name}}{{#if hidden}} (Hidden){{/if}}{{#if defeated}} (Defeated){{else}}{{#if done}} (Done){{/if}}{{/if}}</span>
              {{#if canSelect}}
                <button type="button" data-side-action="select" data-member-id="{{id}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}">
                  {{#if selected}}Acting · Undo{{else}}Choose to Act{{/if}}
                </button>
              {{/if}}
              {{#if canMark}}
                <button type="button" data-side-action="mark" data-member-id="{{id}}">
                  {{#if done}}Undo Done{{else}}Mark Done{{/if}}
                </button>
              {{/if}}
            </li>
          {{else}}
            <li>No combatants visible</li>
          {{/each}}
        </ul>
      </div>
    {{/each}}
    {{#if reserveMembers.length}}
      <details>
        <summary>Queue a new party for next round</summary>
        <label>Party name <input name="pte-late-party-name" type="text"></label>
        <label>Initiative <input name="pte-late-party-score" type="number" step="any"></label>
        {{#each reserveMembers}}
          <label><input name="pte-late-party-member" type="checkbox" value="{{id}}"> {{name}}</label>
        {{/each}}
        <button type="button" data-side-action="queue-party">Queue Party</button>
      </details>
    {{/if}}
    {{#if canManage}}
      <button type="button" data-side-action="advance">{{#if partyMode}}End Party Initiative{{else}}End Side Turn{{/if}}</button>
      <button type="button" data-side-action="end">End Combat</button>
    {{/if}}
  {{/if}}
</section>
