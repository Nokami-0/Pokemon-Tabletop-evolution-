<div class="pte-body">
  <header class="pte-banner"><div><span>{{item.type}}</span><input aria-label="Name" name="name" value="{{item.name}}" {{#unless editable}}readonly{{/unless}}></div></header>
  <fieldset {{#unless editable}}disabled{{/unless}}>
    <div class="pte-grid">
      {{#if move}}
      <label>Type <select name="system.element" data-element="{{system.element}}">{{#each elements}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
      <label>Category <select name="system.category">{{#each categories}}<option {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
      <label class="pte-check"><input type="checkbox" name="system.accuracyRequired" {{#if system.accuracyRequired}}checked{{/if}}> Requires accuracy check</label>
      <label>AC <input type="number" name="system.ac" value="{{system.ac}}"></label>
      {{#if variableDb}}<p>Damage Base · {{variableDb}}. Set the value when rolling.</p>
      {{else}}<label>Damage Base <input type="number" min="0" max="28" name="system.db" value="{{system.db}}"></label>{{/if}}
      <label>Crit Range <input type="number" min="1" max="20" name="system.crit" value="{{system.crit}}"></label>
      <label>Damage Modifier <input type="number" name="system.damage" value="{{system.damage}}"></label>
      <label>Range <input name="system.range" value="{{system.range}}"></label>
      <button type="button" data-action="moveRange">Place Range</button>
      {{/if}}
      {{#if gear}}
      {{#if variants}}<label>Potion Variant <select name="system.variant"><option value="">Choose a variant</option>
        {{#each variants}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select></label>{{/if}}
      <label>Unit Price <input name="system.price" value="{{price}}"></label>
      <label>Quantity <input type="number" min="0" name="system.quantity" value="{{system.quantity}}"></label>
      <label>Slot keyword override <input name="system.slotKeywords" value="{{system.slotKeywords}}" placeholder="e.g. Medium, Equipment - Armor, Pokémon"></label>
      <small>Item keywords · {{gearKeywords}}</small>
      {{#if ownedGear}}<label class="pte-check">Impaired <input type="checkbox" name="system.impaired" {{#if system.impaired}}checked{{/if}}></label>{{/if}}
      {{else}}
      <label>Frequency <input name="system.frequency" value="{{frequency}}"></label>
      <label>Action <input name="system.action" value="{{action}}"></label>
      {{/if}}
      <label>Fixed SP cost <input type="number" name="system.spiritCost" min="0" max="6" value="{{system.spiritCost}}"></label>
      <label>Source / Page <input name="system.source" value="{{system.source}}"></label>
    </div>
    {{#if canPaySpirit}}<button type="button" data-action="paySpirit">Spend {{system.spiritCost}} SP</button>{{/if}}
    {{#if prerequisites}}<p><strong>Prerequisites</strong></p><ul>{{#each prerequisites}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
    {{#if keywords}}<p><strong>Keywords</strong> {{#each keywords}}{{this}} {{/each}}</p>{{/if}}
    {{#if tierName}}<p>{{tierName}}</p>{{/if}}
    {{#if requirements}}<p><strong>Weapon requirements</strong> {{requirements}}</p>{{/if}}
    {{#if versatile}}<p>This attack has a Versatile effect. See the reference.</p>{{/if}}
    {{#if sourceLink}}<p><a href="{{sourceLink}}" target="_blank" rel="noopener noreferrer">Open source page</a></p>{{/if}}
    {{#if pokemonMove}}<label class="pte-check"><input type="checkbox" name="system.slotExempt" {{#if system.slotExempt}}checked{{/if}}> Granted attack · no Battle slot</label>{{/if}}
    {{#if pricePage}}<p>Price reference · PTE Rule Book p. {{pricePage}}{{#if priceNote}} · {{priceNote}}{{/if}}</p>{{/if}}
    {{#if parentClass}}<p><strong>Class</strong> · {{parentClass}}</p>{{/if}}
    <label>Effects and rules <textarea name="system.description" rows="6">{{description}}</textarea></label>
    {{#if classGrants}}<section>
      <h2>Granted Benefits</h2>
      {{#each classGrants}}
        <div class="pte-row">
          {{#if grantedNames}}<strong>{{label}}</strong><span>{{grantedNames}}</span>{{else}}
            {{#if canClaim}}<button type="button" data-action="claimGrant" data-grant="{{id}}">{{label}}</button>
            {{else}}{{#if needsTerrain}}<small>Record a matching Naturewalk terrain to choose an ability.</small>{{/if}}{{#if minFeatures}}<small>{{label}} · Requires {{minFeatures}} class features</small>{{/if}}
            {{#if minLevel}}<small>{{label}} · Level {{minLevel}}{{#if requiresPrevious}} and prior grant{{/if}}</small>{{/if}}{{/if}}
          {{/if}}
        </div>
      {{/each}}
    </section>{{/if}}
    {{#if classCharts}}<section>
      <h2>Class Reference</h2>
      {{#each classCharts}}
        <details {{#if source}}open{{/if}}><summary>{{title}}</summary>
          {{#if source}}<p><small>{{#if source.url}}<a href="{{source.url}}" target="_blank" rel="noopener noreferrer">{{source.label}}</a>{{else}}{{source.label}}{{/if}}</small></p>{{/if}}
          <dl>
          {{#each rows}}
            <dt><strong>{{name}}</strong>{{#if applies}} · Your Naturewalk{{/if}}</dt>
            <dd>{{#if text}}<span class="pte-rule-text">{{text}}</span>{{/if}}
              {{#if prerequisites}}<ul>{{#each prerequisites}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
              {{#if source}}<small>{{#if source.url}}<a href="{{source.url}}" target="_blank" rel="noopener noreferrer">{{source.label}}</a>{{else}}{{source.label}}{{/if}}</small>{{/if}}
            </dd>
          {{/each}}
          </dl>
        </details>
      {{/each}}
    </section>{{/if}}
    {{#if classFeatures}}<section>
      <h2>Class Features</h2>
      {{#each classFeatures}}
        <details><summary>{{name}}{{#if ownedId}} · Owned{{/if}}</summary>
          {{#if prerequisites}}<ul>{{#each prerequisites}}<li>{{this}}</li>{{/each}}</ul>{{/if}}
          {{#if frequency}}<p>{{frequency}}{{#if action}} · {{action}}{{/if}}</p>{{/if}}
          {{#if description}}<p class="pte-rule-text">{{description}}</p>{{/if}}
          {{#if ownedId}}<button type="button" data-action="openClassFeature" data-id="{{ownedId}}">Open Feature</button>{{/if}}
          {{#if canAdd}}<button type="button" data-action="addClassFeature" data-index="{{index}}">Add Feature</button>{{/if}}
        </details>
      {{/each}}
    </section>{{/if}}
  </fieldset>
</div>
